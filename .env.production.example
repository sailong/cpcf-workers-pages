# Public hostnames. Create DNS records for CONSOLE_HOST and *.PROJECTS_BASE_DOMAIN.
CONSOLE_HOST=console.example.com
PROJECTS_BASE_DOMAIN=apps.example.com

# The manager, project runtime, and Caddy use one immutable Docker Hub image.
CCFWP_IMAGE_REPOSITORY=docker.io/example/ccfwp-platform
CCFWP_IMAGE_TAG=v1.0.0

# Signed application releases. Use a strict vX.Y.Z tag, never latest.
CCFWP_GITHUB_REPOSITORY=sailong/cpcf-workers-pages
CCFWP_RELEASE_SIGNER_ISSUER=https://token.actions.githubusercontent.com
CCFWP_RELEASE_RETENTION=3
CCFWP_MAX_RELEASE_BYTES=2147483648

# Caddy DNS-01 / ACME settings.
ACME_EMAIL=admin@example.com
ACME_CA=https://acme-v02.api.letsencrypt.org/directory
CLOUDFLARE_API_TOKEN=replace-with-zone-dns-edit-token

# Platform credentials. Generate the ingress token with: openssl rand -hex 32
AUTH_PASSWORD=replace-with-a-strong-admin-password
INGRESS_PROXY_TOKEN=replace-with-at-least-32-random-characters
CCFWP_UPDATER_TOKEN=replace-with-an-independent-32-byte-random-token

# Build dependency trust defaults. prefer-offline uses cache first and only allowlisted registries.
BUILD_NETWORK_MODE=prefer-offline
BUILD_REGISTRY_ALLOWLIST=https://registry.npmmirror.com/,https://registry.npmjs.org/
BUILD_DEFAULT_REGISTRY=https://registry.npmmirror.com/
