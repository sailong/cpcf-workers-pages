# Public hostnames. Use the same root domain when 1Panel serves the apex and wildcard hosts.
CONSOLE_HOST=example.com
PROJECTS_BASE_DOMAIN=example.com

# Immutable Docker Hub image and stable host storage.
CCFWP_IMAGE_REPOSITORY=docker.io/simonchang/ccfwp-platform
CCFWP_IMAGE_TAG=v1.2.10
CCFWP_MANAGER_HOST_PORT=38003
CCFWP_DATA_DIR=/opt/1panel/apps/ccfwp/data

# Signed GitHub application releases.
CCFWP_GITHUB_REPOSITORY=sailong/cpcf-workers-pages
CCFWP_RELEASE_SIGNER_ISSUER=https://token.actions.githubusercontent.com
CCFWP_RELEASE_RETENTION=3
CCFWP_MAX_RELEASE_BYTES=2147483648

# Docker Engine compatibility. Keep the v prefix.
DOCKER_API_VERSION=v1.44

# Platform credentials. Generate the two tokens independently with: openssl rand -hex 32
AUTH_PASSWORD=replace-with-a-strong-admin-password
INGRESS_PROXY_TOKEN=replace-with-at-least-32-random-characters
CCFWP_UPDATER_TOKEN=replace-with-an-independent-32-byte-random-token

# Build dependency trust defaults.
BUILD_NETWORK_MODE=prefer-offline
BUILD_REGISTRY_ALLOWLIST=https://registry.npmmirror.com/,https://registry.npmjs.org/
BUILD_DEFAULT_REGISTRY=https://registry.npmmirror.com/
